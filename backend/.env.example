# MongoDB (local Docker via docker-compose.yml)
MONGO_URI=mongodb://admin:password@localhost:27017/?authSource=admin
MONGO_DB_NAME=ecosync

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Maps (optional - platform falls back to haversine/rough geocode)
# Get a key: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# AI matchmaking (optional - heuristic scoring works without these)
# AI_PROVIDER=gemini | openai | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
